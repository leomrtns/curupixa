@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(NOT @BUILD_SHARED_LIBS@)
  # Static archives export these private link requirements. Shared consumers
  # only need the codecs' runtime libraries, not their development headers.
  if(@CURUPIXA_ENABLE_ZLIB@)
    find_dependency(ZLIB)
  endif()
  if(@CURUPIXA_ENABLE_BZIP2@)
    find_dependency(BZip2)
  endif()
  if(@CURUPIXA_ENABLE_LZMA@)
    find_dependency(LibLZMA)
  endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/curupixaTargets.cmake")
check_required_components(curupixa)
