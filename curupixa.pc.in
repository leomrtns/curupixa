prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: curupixa
Description: Low-level phylogenetics library with recoverable errors and explicit state
Version: @PACKAGE_VERSION@
Libs: -L${libdir} -lcurupixa
Libs.private: @CURUPIXA_PC_LIBS_PRIVATE@
Cflags: -I${includedir} -I${includedir}/curupixa @CURUPIXA_PC_CFLAGS@
