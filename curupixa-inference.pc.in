prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: curupixa-inference
Description: Inference from phylogenetic scores and tree samples
Version: @PACKAGE_VERSION@
Requires: curupixa-gene-species
Libs: -L${libdir} -lcurupixa_inference
Libs.private:
Cflags: -I${includedir} -I${includedir}/curupixa @CURUPIXA_PC_CFLAGS@
