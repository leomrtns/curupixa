prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: curupixa-gene-species
Description: Gene-tree species-tree algorithms
Version: @PACKAGE_VERSION@
Requires: curupixa-phylogenetics
Libs: -L${libdir} -lcurupixa_gene_species
Libs.private:
Cflags: -I${includedir} -I${includedir}/curupixa @CURUPIXA_PC_CFLAGS@
