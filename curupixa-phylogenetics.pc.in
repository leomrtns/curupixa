prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: curupixa-phylogenetics
Description: General phylogenetics and numerical primitives
Version: @PACKAGE_VERSION@
Libs: -L${libdir} -lcurupixa_phylogenetics
Libs.private: @CURUPIXA_PC_LIBS_PRIVATE@
Cflags: -I${includedir} -I${includedir}/curupixa @CURUPIXA_PC_CFLAGS@
